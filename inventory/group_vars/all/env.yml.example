---
# Deployment-specific variables — copy to env.yml and set values for your
# environment. env.yml is gitignored — never commit it.
#
# domain, kerberos_realm, ipa_primary, gitlab_url, vault_addr, ansible_user,
# rsyslog_remote_*, and the vault_kv_* vars come from ../../../inventory-common
# (a second inventory source in ansible.cfg) and do NOT need to be set here.
# Only override them below if this deployment needs to differ from the
# shared environment.

# Foreman FQDN — must match the hostname defined for the `foreman` group in
# ../../../inventory-common/hosts.yml
foreman:        foreman.example.com

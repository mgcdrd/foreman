---
# Environment-wide variables — copy to env.yml and set values for your environment.
# env.yml is gitignored — never commit it.

domain:         example.com
kerberos_realm: EXAMPLE.COM
ipa_primary:    ipa.example.com
gitlab_url:     https://gitlab.example.com
vault_addr:     https://vault.example.com

# Vault KV mount and environment path prefix.
# Secrets are looked up as: <vault_kv_infra_mount>/<vault_kv_env>/<secret>
vault_kv_infra_mount: infra
vault_kv_env:         lab

# Foreman FQDN — must match the hostname in inventory/hosts.yml
foreman:        foreman.example.com

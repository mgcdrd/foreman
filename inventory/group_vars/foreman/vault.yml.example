---
# All secrets resolved at runtime from HashiCorp Vault.
# Set VAULT_ADDR and VAULT_TOKEN (or use approle) before running.
#
# Copy this file to vault.yml and it will work as-is once vault_kv_infra_mount
# and vault_kv_env are set in group_vars/all/env.yml.
# vault.yml is gitignored — never commit it.

vault_foreman_admin_username: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.admin_username }}"
vault_foreman_admin_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.admin_password }}"
vault_foreman_db_password:    "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.db_password }}"
vault_foreman_host_root_pass: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.host_root_pass }}"
vault_foreman_realm_agent_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.realm_agent_password }}"
vault_foreman_template_sync_ssh_private_key: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.template_sync_ssh_private_key }}"
vault_foreman_template_sync_ssh_public_key: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.template_sync_ssh_public_key }}"

vault_ipa_admin_user:     "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/ipa/domain_admin', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.username }}"
vault_ipa_admin_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/ipa/domain_admin', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.password }}"

# Only needed if foreman_ldap_auth_sources is set (IPA fallback) — bind account
# password for the LDAP auth source's account_password.
vault_foreman_ldap_bind_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.ldap_bind_password }}"

vault_pdns_api_key: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/pdns', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.api_key }}"

vault_pve2_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/root', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.pve2_password }}"
vault_pve3_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/root', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.pve3_password }}"
vault_pve4_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/root', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.pve4_password }}"
vault_pve6_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/root', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.pve6_password }}"

# Password for whichever PVE node hosts the Foreman VM (Phase 0 disk expansion).
# Set foreman_proxmox_node in vars.yml to match — the lookup key matches that node.
vault_pve_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/proxmox/root', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret[foreman_proxmox_node + '_password'] }}"

# site.yml wires acme_sh_pdns_url (foreman_pdns_api_url) / acme_sh_pdns_token
# (vault_pdns_api_key) for the dns_pdns challenge.
vault_acme_email: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/acme', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.email }}"

# Only read when foreman_acme_ca: google — populate infra/<env>/acme/google
# with an EAB keypair from `gcloud publicca external-account-keys create`
# before switching. site.yml's ternaries skip these lookups otherwise, so
# this path does not need to exist for the default (letsencrypt) CA.
vault_acme_google_eab_kid:      "{{ (lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/acme/google', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.kid) if foreman_acme_ca == 'google' else '' }}"
vault_acme_google_eab_hmac_key: "{{ (lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/acme/google', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.hmac_key) if foreman_acme_ca == 'google' else '' }}"

# Uncomment once AWX job templates are created:
# vault_awx_host_config_key: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/awx/host_callback', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.host_config_key }}"

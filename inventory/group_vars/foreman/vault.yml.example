---
# All secrets resolved at runtime from HashiCorp Vault.
# Set VAULT_ADDR and VAULT_TOKEN (or use approle) before running.
#
# Copy this file to vault.yml and it will work as-is once vault_kv_infra_mount
# and vault_kv_env are set in group_vars/all/env.yml.
# vault.yml is gitignored — never commit it.
#
# Each variable is the role's own interface variable, set directly to a Vault
# lookup — no vault_* intermediate.

foreman_admin_username:                  "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.admin_username }}"
foreman_admin_password:                  "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.admin_password }}"
foreman_db_password:                     "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.db_password }}"
foreman_host_root_pass:                  "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.host_root_pass }}"
foreman_realm_agent_password:            "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.realm_agent_password }}"
foreman_template_sync_ssh_private_key:   "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.template_sync_ssh_private_key }}"
foreman_template_sync_ssh_public_key:    "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.template_sync_ssh_public_key }}"

# IPA account scoped to reset only the realm principal's password
# (used when foreman_realm_vault_rotate is true).
foreman_ipa_admin_user:                  "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/ipa/domain_admin', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.username }}"
foreman_ipa_admin_password:              "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/ipa/domain_admin', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.password }}"

# PowerDNS API key: used by the smart proxy and the acme_sh dns_pdns challenge.
foreman_pdns_api_key:                    "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/pdns', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.api_key }}"
acme_sh_pdns_token:                      "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/pdns', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.api_key }}"

# ACME account email.
acme_sh_register_email:                  "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/acme', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.email }}"

# Only read when acme_sh_ca: google (vars.yml) — populate
# <env>/acme/google/<foreman_hostname> with an EAB keypair using
# mgcdrd.infrasvc.google_publicca_eab before switching. The path is keyed
# by foreman_hostname because a Google Public CA EAB key is single-use — it
# registers exactly one ACME account and expires unused after 7 days. The
# ternary skips the lookup for the default (letsencrypt) CA.
acme_sh_eab_kid:                         "{{ (lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/acme/google/' + foreman_hostname, engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.kid) if acme_sh_ca == 'google' else '' }}"
acme_sh_eab_hmac_key:                    "{{ (lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/acme/google/' + foreman_hostname, engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.hmac_key) if acme_sh_ca == 'google' else '' }}"

# Only needed if foreman_ldap_auth_sources is set (IPA fallback): set its
# account_password to this lookup inline, in vars.yml:
#   account_password: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/foreman', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.ldap_bind_password }}"
#
# Proxmox compute resource passwords are inlined in vars.yml's
# foreman_compute_resources (<env>/proxmox/root, keys pve<N>_password).

# Uncomment once AWX job templates are created:
# foreman_awx_host_config_key: "{{ lookup('community.hashi_vault.vault_kv2_get', vault_kv_env + '/awx/host_callback', engine_mount_point=vault_kv_infra_mount, url=vault_addr).secret.host_config_key }}"
